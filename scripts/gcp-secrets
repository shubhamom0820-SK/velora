#!/usr/bin/env bash
# Each environment's secrets into its Google Cloud project's Secret Manager
# (P-49, D-1022), with a second copy in the founder's Keychain, every copy
# compared by the first 8 hex characters of its SHA-256. The founder runs it, on
# his Mac, from the repo root, one environment at a time:
#
#   scripts/gcp-secrets staging
#   scripts/gcp-secrets production
#
# No value is ever printed, put in a command's arguments, written to a file, or
# read from the clipboard. Values travel only through pipes and shell variables
# (printf is a builtin, so it never appears in `ps`). Only prefixes are printed.
#
# Safe to run again: a secret whose latest version already holds the same value
# is left alone, and a key that exists is never generated again.
#
# staging     The 10 values in the Keychain (service velora-staging) go to Secret
#             Manager. Razorpay's 3, which exist only on Fly, go from the staging
#             API's machine to Secret Manager and the Keychain. A fresh VAPID pair is
#             made into both. The Sentry DSN is asked for at a hidden prompt (Enter
#             skips). Then every name is compared across Secret Manager, the
#             Keychain, Fly's API and Fly's worker.
# production  Nothing comes from staging. The four keys and a VAPID pair are
#             generated fresh into the Keychain (service velora-production) and
#             Secret Manager. R2's pair comes from the Keychain (service velora-prod).
#             The rest is asked for at hidden prompts (Enter skips any you don't
#             have yet). Then every name is compared between Secret Manager and the
#             Keychain, and the generated keys are checked to differ from staging's.

set -uo pipefail
set +x

case "${1:-}" in
  staging) P=velora-ic-staging; KC=velora-staging ;;
  production) P=velora-ic-prod; KC=velora-production ;;
  *) echo "usage: scripts/gcp-secrets staging|production"; exit 2 ;;
esac
ENVNAME="$1"
[ -d api ] && [ -f api/app/core/vapid.py ] || { echo "STOPPED: run from the repo root"; exit 2; }
command -v gcloud >/dev/null || { echo "STOPPED: no gcloud on PATH"; exit 2; }
FAILED=0

say() { printf '%s\n' "$*"; }
bad() { printf 'FAILED: %s\n' "$*"; FAILED=1; }

# The first 8 hex characters of SHA-256 of stdin.
pfx() { shasum -a 256 | cut -c1-8; }

# Secret Manager: the latest version's prefix, or "-" if the slot is empty.
sm_pfx() {
  local p
  if p="$(gcloud secrets versions access latest --secret="$1" --project="${2:-$P}" 2>/dev/null | pfx)" \
    && gcloud secrets versions list "$1" --project="${2:-$P}" --filter=state=ENABLED --limit=1 \
         --format='value(name)' 2>/dev/null | grep -q .; then
    printf '%s' "$p"
  else
    printf '%s' "-"
  fi
}

# The Keychain: whether an account exists, its value (into a variable only), its prefix.
kc_has() { security find-generic-password -s "${2:-$KC}" -a "$1" >/dev/null 2>&1; }
kc_val() { security find-generic-password -s "${2:-$KC}" -a "$1" -w 2>/dev/null | tr -d '\n'; }
kc_pfx() { if kc_has "$1" "${2:-$KC}"; then kc_val "$1" "${2:-$KC}" | pfx; else printf '%s' "-"; fi; }

# to_sm NAME VALUE: a new version, unless the latest already holds this value.
to_sm() {
  local name="$1" value="$2" want have
  [ -n "$value" ] || { bad "$name: empty, nothing stored"; return 1; }
  case "$value" in *$'\n'*) bad "$name: holds a line break, not stored"; return 1 ;; esac
  want="$(printf '%s' "$value" | pfx)"
  have="$(sm_pfx "$name")"
  if [ "$have" = "$want" ]; then
    say "  $name: Secret Manager already holds it ($want)"
    return 0
  fi
  if printf '%s' "$value" | gcloud secrets versions add "$name" --project="$P" --data-file=- >/dev/null 2>&1; then
    say "  $name: stored in Secret Manager ($want)"
  else
    bad "$name: Secret Manager refused it"
    return 1
  fi
}

# kc_put ACCOUNT VALUE: into the Keychain, then read back and compared.
# `security -i` reads its command on stdin, so the value is never an argument.
kc_put() {
  local account="$1" value="$2"
  case "$value" in
    *[[:space:]\"\'\\]*) bad "$account: holds a space, quote or backslash; not put in the Keychain"; return 1 ;;
  esac
  printf 'add-generic-password -U -s %s -a %s -w %s\n' "$KC" "$account" "$value" | security -i >/dev/null 2>&1
  if [ "$(kc_pfx "$account")" = "$(printf '%s' "$value" | pfx)" ]; then
    say "  $account: in the Keychain ($KC)"
  else
    bad "$account: the Keychain's copy doesn't match after writing"
    return 1
  fi
}

# ask NAME CHECK PROMPT: a hidden prompt; Enter skips. CHECK is a glob the value must match.
ASKED=""
ask() {
  local name="$1" check="$2" prompt="$3"
  ASKED=""
  read -r -s -p "$prompt (nothing will show; Enter skips): " ASKED; echo
  [ -n "$ASKED" ] || { say "  $name: skipped"; return 1; }
  # shellcheck disable=SC2254
  case "$ASKED" in
    $check) return 0 ;;
    *) bad "$name: not the expected shape ($check); nothing stored"; ASKED=""; return 1 ;;
  esac
}

# vapid: the Keychain's pair if it has one, else a fresh pair into the Keychain;
# then both into Secret Manager. Never a second pair over an existing one.
vapid() {
  local pair priv pub
  if kc_has vapid-private-key && kc_has vapid-public-key; then
    say "  VAPID: the Keychain already holds a pair; using it"
  elif kc_has vapid-private-key || kc_has vapid-public-key; then
    bad "VAPID: the Keychain holds half a pair; fix by hand before running again"
    return 1
  else
    if [ "$(sm_pfx VAPID_PRIVATE_KEY)" != "-" ] || [ "$(sm_pfx VAPID_PUBLIC_KEY)" != "-" ]; then
      bad "VAPID: Secret Manager holds a pair the Keychain doesn't; not replacing it"
      return 1
    fi
    pair="$(cd api && uv run --quiet python -m app.core.vapid)" || { bad "VAPID: the generator failed"; return 1; }
    priv="$(printf '%s\n' "$pair" | sed -n 's/^VAPID_PRIVATE_KEY=//p')"
    pub="$(printf '%s\n' "$pair" | sed -n 's/^VAPID_PUBLIC_KEY=//p')"
    unset pair
    [ -n "$priv" ] && [ -n "$pub" ] || { bad "VAPID: the generator's output wasn't a pair"; return 1; }
    kc_put vapid-private-key "$priv" && kc_put vapid-public-key "$pub" || return 1
    unset priv pub
    say "  VAPID: a fresh pair made"
  fi
  to_sm VAPID_PRIVATE_KEY "$(kc_val vapid-private-key)"
  to_sm VAPID_PUBLIC_KEY "$(kc_val vapid-public-key)"
}

# fly_pfx APP NAMES...: each name's prefix as the running Fly machine holds it,
# computed there; the value never leaves the machine. "-" where it isn't set.
fly_pfx() {
  local app="$1"; shift
  printf 'import hashlib, os\nfor n in %s:\n    v = os.environ.get(n)\n    print(n, hashlib.sha256(v.encode()).hexdigest()[:8] if v else "-")\n' \
    "$(printf '"%s",' "$@" | sed 's/^/[/; s/,$/]/')" \
    | flyctl ssh console -a "$app" -C "python -" 2>/dev/null | tr -d '\r'
}

# ----------------------------------------------------------------------------
if [ "$ENVNAME" = staging ]; then
  say "=== staging: from the Keychain ($KC) to Secret Manager"
  for pair in DATABASE_URL:database-url REDIS_URL:redis-url JWT_SECRET:jwt-secret \
              PHONE_PEPPER:phone-pepper PHONE_ENC_KEY:phone-enc-key CODE_PEPPER:code-pepper \
              R2_ACCESS_KEY_ID:r2-access-key-id R2_SECRET_ACCESS_KEY:r2-secret-access-key \
              SIGHTENGINE_API_USER:sightengine-api-user SIGHTENGINE_API_SECRET:sightengine-api-secret; do
    name="${pair%%:*}"; account="${pair#*:}"
    if kc_has "$account"; then to_sm "$name" "$(kc_val "$account")"; else bad "$account: not in the Keychain"; fi
  done

  say "=== staging: Razorpay's three, from Fly's staging API to Secret Manager and the Keychain"
  for pair in RAZORPAY_KEY_ID:razorpay-key-id RAZORPAY_KEY_SECRET:razorpay-key-secret \
              RAZORPAY_WEBHOOK_SECRET:razorpay-webhook-secret; do
    name="${pair%%:*}"; account="${pair#*:}"
    v="$(flyctl ssh console -a velora-api-staging -C "printenv $name" 2>/dev/null | tr -d '\r\n')"
    if [ -z "$v" ]; then bad "$name: nothing read from Fly"; continue; fi
    kc_put "$account" "$v" && to_sm "$name" "$v"
    unset v
  done

  say "=== staging: the VAPID pair"
  vapid

  say "=== staging: the Sentry DSN (Secret Manager only; Sentry's dashboard is its source)"
  if ask SENTRY_DSN 'https://*@*/*' "Paste staging's Sentry DSN"; then to_sm SENTRY_DSN "$ASKED"; fi
  ASKED=""

  say "=== staging: every copy compared (first 8 hex of SHA-256; - = not set there)"
  NAMES=(DATABASE_URL REDIS_URL JWT_SECRET PHONE_PEPPER PHONE_ENC_KEY CODE_PEPPER
         R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY RAZORPAY_KEY_ID RAZORPAY_KEY_SECRET
         RAZORPAY_WEBHOOK_SECRET SIGHTENGINE_API_USER SIGHTENGINE_API_SECRET
         VAPID_PRIVATE_KEY VAPID_PUBLIC_KEY SENTRY_DSN)
  FLY_API="$(fly_pfx velora-api-staging "${NAMES[@]}")"
  FLY_WORKER="$(fly_pfx velora-worker-staging "${NAMES[@]}")"
  [ -n "$FLY_API" ] || bad "Fly's API: no answer"
  [ -n "$FLY_WORKER" ] || bad "Fly's worker: no answer"
  printf '%-24s %-9s %-9s %-9s %-9s %s\n' NAME SECRETMGR KEYCHAIN FLY-API FLY-WORKR VERDICT
  for name in "${NAMES[@]}"; do
    account="$(printf '%s' "$name" | tr '[:upper:]_' '[:lower:]-')"
    s="$(sm_pfx "$name")"; k="$(kc_pfx "$account")"
    a="$(printf '%s\n' "$FLY_API" | awk -v n="$name" '$1 == n { print $2 }')"; a="${a:--}"
    w="$(printf '%s\n' "$FLY_WORKER" | awk -v n="$name" '$1 == n { print $2 }')"; w="${w:--}"
    verdict=same
    [ "$s" = "-" ] && verdict="not in Secret Manager"
    for x in "$k" "$a" "$w"; do
      if [ "$x" != "-" ] && [ "$x" != "$s" ]; then verdict=DIFFERENT; fi
    done
    # Only the VAPID pair may be empty: push is off until D-857. SENTRY_DSN is
    # required (T-9.12, D-1001): the VM's deploy stops without it.
    case "$name" in
      VAPID_*) [ "$s" = "-" ] && verdict="empty (optional)" ;;
    esac
    [ "$verdict" = DIFFERENT ] && FAILED=1
    case "$verdict" in "not in Secret Manager") FAILED=1 ;; esac
    printf '%-24s %-9s %-9s %-9s %-9s %s\n' "$name" "$s" "$k" "$a" "$w" "$verdict"
  done
fi

# ----------------------------------------------------------------------------
if [ "$ENVNAME" = production ]; then
  say "=== production: the four keys, fresh, never staging's (Keychain $KC, then Secret Manager)"
  for spec in JWT_SECRET:jwt-secret:64 PHONE_PEPPER:phone-pepper:32 PHONE_ENC_KEY:phone-enc-key:32 CODE_PEPPER:code-pepper:32; do
    name="${spec%%:*}"; rest="${spec#*:}"; account="${rest%%:*}"; bytes="${rest#*:}"
    if kc_has "$account"; then
      say "  $account: the Keychain already holds one; using it"
    elif [ "$(sm_pfx "$name")" != "-" ]; then
      bad "$name: Secret Manager holds a value the Keychain doesn't; not replacing it"
      continue
    else
      v="$(openssl rand -hex "$bytes")"
      kc_put "$account" "$v" || { unset v; continue; }
      unset v
    fi
    to_sm "$name" "$(kc_val "$account")"
  done

  say "=== production: the VAPID pair, fresh"
  vapid

  say "=== production: R2's pair, from the Keychain (service velora-prod)"
  for pair in R2_ACCESS_KEY_ID:r2-access-key-id R2_SECRET_ACCESS_KEY:r2-secret-access-key; do
    name="${pair%%:*}"; account="${pair#*:}"
    if kc_has "$account" velora-prod; then to_sm "$name" "$(kc_val "$account" velora-prod)"; else bad "$account: not in the Keychain (velora-prod)"; fi
  done

  say "=== production: values only you have (hidden prompts; Enter skips any you don't have yet)"
  # Fields are separated by |, never :, which the URL checks themselves contain.
  for spec in "DATABASE_URL|database-url|postgresql+asyncpg://*|production's direct connection as velora_api (postgresql+asyncpg://…?ssl=require)" \
              "REDIS_URL|redis-url|rediss://*|production's Upstash rediss:// URL" \
              "RAZORPAY_KEY_ID|razorpay-key-id|rzp_*|production's Razorpay key id" \
              "RAZORPAY_KEY_SECRET|razorpay-key-secret|?*|production's Razorpay key secret" \
              "RAZORPAY_WEBHOOK_SECRET|razorpay-webhook-secret|?*|production's Razorpay webhook secret" \
              "SIGHTENGINE_API_USER|sightengine-api-user|?*|production's Sightengine API user" \
              "SIGHTENGINE_API_SECRET|sightengine-api-secret|?*|production's Sightengine API secret"; do
    IFS='|' read -r name account check what <<<"$spec"
    prompt="Paste $what"
    if kc_has "$account"; then
      say "  $name: the Keychain already holds it; using it"
      to_sm "$name" "$(kc_val "$account")"
    elif ask "$name" "$check" "$prompt"; then
      kc_put "$account" "$ASKED" && to_sm "$name" "$ASKED"
    fi
    ASKED=""
  done
  if ask SENTRY_DSN 'https://*@*/*' "Paste production's Sentry DSN"; then to_sm SENTRY_DSN "$ASKED"; fi
  ASKED=""

  say "=== production: every copy compared (first 8 hex of SHA-256; - = not set there)"
  printf '%-24s %-9s %-9s %-9s %s\n' NAME SECRETMGR KEYCHAIN STAGING VERDICT
  for name in DATABASE_URL REDIS_URL JWT_SECRET PHONE_PEPPER PHONE_ENC_KEY CODE_PEPPER \
              R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY RAZORPAY_KEY_ID RAZORPAY_KEY_SECRET \
              RAZORPAY_WEBHOOK_SECRET SIGHTENGINE_API_USER SIGHTENGINE_API_SECRET \
              VAPID_PRIVATE_KEY VAPID_PUBLIC_KEY SENTRY_DSN; do
    account="$(printf '%s' "$name" | tr '[:upper:]_' '[:lower:]-')"
    case "$name" in R2_*) k="$(kc_pfx "$account" velora-prod)" ;; *) k="$(kc_pfx "$account")" ;; esac
    s="$(sm_pfx "$name")"
    st="$(sm_pfx "$name" velora-ic-staging)"
    verdict=same
    if [ "$s" = "-" ]; then
      verdict="not set yet: production can't deploy without it"
      case "$name" in VAPID_*) verdict="empty (optional)" ;; esac
    elif [ "$k" != "-" ] && [ "$k" != "$s" ]; then
      verdict=DIFFERENT; FAILED=1
    elif [ "$k" = "-" ] && [ "$name" != SENTRY_DSN ]; then
      verdict="no Keychain copy"; FAILED=1
    fi
    # Generated keys must never be staging's (infra/PRODUCTION.md); R2's and the
    # providers' accounts may be shared by design, so they aren't held to it.
    case "$name" in
      JWT_SECRET|PHONE_PEPPER|PHONE_ENC_KEY|CODE_PEPPER|VAPID_*)
        if [ "$s" != "-" ] && [ "$s" = "$st" ]; then verdict="SAME AS STAGING"; FAILED=1; fi ;;
    esac
    printf '%-24s %-9s %-9s %-9s %s\n' "$name" "$s" "$k" "$st" "$verdict"
  done
  say "Next, by hand: copy production's Keychain entries into Apple Passwords (infra/PRODUCTION.md)."
fi

if [ "$FAILED" -ne 0 ]; then say "=== $ENVNAME: something above FAILED; nothing was printed but prefixes."; exit 1; fi
say "=== $ENVNAME: done; every copy compared."
