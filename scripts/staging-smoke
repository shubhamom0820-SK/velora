#!/usr/bin/env bash
# Checks a deployed environment from the outside (T-1.22): run by deploy.yml
# after every staging deploy, and by deploy-production.yml after every release
# (T-2.6). The name predates production; the checks are the same.
#
#   scripts/staging-smoke API_URL WEB_URL
#
# Bodies are checked as well as status codes: a 404 that still carries the page
# or the schema is a leak (T-1.19's lesson). Exits 1 if any check fails, after
# running them all.
set -euo pipefail

api="${1%/}"
web="${2%/}"
failures=0

say() { printf 'staging-smoke: %s\n' "$*"; }
fail() {
  say "FAIL $*"
  failures=$((failures + 1))
}

# fetch URL [curl args...] → sets $status and $body
fetch() {
  local url="$1" out
  shift
  out="$(curl -s --max-time 20 -w '\n%{http_code}' "$@" "$url" || printf '\n000')"
  status="${out##*$'\n'}"
  body="${out%$'\n'*}"
}

# expect NAME URL STATUS [MUST_CONTAIN] [MUST_NOT_CONTAIN]
expect() {
  local name="$1" url="$2" want="$3" contains="${4:-}" absent="${5:-}"
  fetch "$url"
  if [[ "$status" != "$want" ]]; then
    fail "$name: $url returned $status, want $want"
  elif [[ -n "$contains" && "$body" != *"$contains"* ]]; then
    fail "$name: $url's body lacks '$contains'"
  elif [[ -n "$absent" && "$body" == *"$absent"* ]]; then
    fail "$name: $url's body contains '$absent'"
  else
    say "ok   $name ($status)"
  fi
}

# A new machine can take a moment to reach Postgres and Redis.
for _ in $(seq 1 12); do
  fetch "$api/readyz"
  [[ "$status" == 200 ]] && break
  sleep 5
done
expect "API ready (Postgres and Redis)" "$api/readyz" 200 '"database":"ok"'
expect "API alive" "$api/healthz" 200 '"status":"ok"'
expect "API schema hidden (P-31)" "$api/openapi.json" 404 '"code":"NOT_FOUND"' '"paths"'
expect "API docs hidden (P-31)" "$api/docs" 404 '"code":"NOT_FOUND"' 'swagger'

expect "web loads" "$web/" 200 'Velora'
# ...and it must be our build, calling this API. A page that merely says "Velora" could be anyone's:
# velora-staging.vercel.app is another company's site, and it passed the line above. Only our
# build has this API's URL compiled into its scripts (NEXT_PUBLIC_API_URL).
#
# It passes because the root layout (web/src/app/layout.tsx) mounts QueryProvider, which imports
# src/lib/api.ts, so every page's scripts, the landing page's included, carry the URL. The landing
# page itself is server-rendered (T-2.1). Moving the providers off marketing pages makes this check
# fail, closed, with the message below, and it then needs a new identity marker (P-37).
if [[ "$status" == 200 ]]; then
  calls_api=no
  for chunk in $(grep -o '/_next/static/chunks/[^"]*\.js' <<<"$body" | sort -u || true); do
    fetch "$web$chunk"
    if [[ "$status" == 200 && "$body" == *"$api"* ]]; then
      calls_api=yes
      break
    fi
  done
  if [[ "$calls_api" == yes ]]; then
    say "ok   web is our build, calling $api"
  else
    fail "web: no script on $web calls $api — another site at that URL, or NEXT_PUBLIC_API_URL unset"
  fi
fi
# ...and it must be built for this environment (T-2.6). APP_ENV decides the site's own address,
# which every page states as its canonical URL. A build refuses an APP_ENV it doesn't know
# (web/src/lib/build-env.ts), but an allowlist can't catch a valid, wrong one: staging's value on
# the production project would build an unindexed copy pointing at staging. This catches both.
fetch "$web/"
canonical="$(grep -o '<link rel="canonical" href="[^"]*"' <<<"$body" | head -n 1 | cut -d'"' -f4 || true)"
if [[ "${canonical%/}" == "$web" ]]; then
  say "ok   web is built for $web (its canonical address)"
else
  fail "web: the home page's canonical address is '${canonical:-missing}', not $web — built for another environment, or with APP_ENV unset"
fi
expect "web /admin hidden (P-30)" "$web/admin" 404 '' 'Coming soon.'
expect "web /dev/ui hidden" "$web/dev/ui" 404 '' 'UI primitives'
expect "web /dev/health hidden" "$web/dev/health" 404 '' 'API health'

# The legal pages (T-2.2): reachable, each with its own title.
expect "web /terms" "$web/terms" 200 'Terms and conditions'
expect "web /privacy" "$web/privacy" 200 'Privacy policy'
expect "web /refunds" "$web/refunds" 200 'Refund policy'
expect "web /contact" "$web/contact" 200 'Contact and grievances'

# The API must accept the web's origin, or every browser call fails.
headers="$(curl -s --max-time 20 -o /dev/null -D - -H "Origin: $web" "$api/healthz" || true)"
allowed="$(grep -i '^access-control-allow-origin:' <<<"$headers" | tr -d '\r' | cut -d' ' -f2- || true)"
if [[ "$allowed" == "$web" ]]; then
  say "ok   API allows the web's origin (CORS)"
else
  fail "API's CORS_ORIGINS doesn't allow $web (got '${allowed:-nothing}')"
fi

if ((failures > 0)); then
  say "$failures check(s) failed."
  exit 1
fi
say "every check passed."
