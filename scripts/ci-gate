#!/usr/bin/env bash
# The /done gate (T-1.20, D-044): exits 0 only when the CI workflow has passed
# for this exact commit, so main is only ever fast-forwarded to a checked one.
# Everything else fails closed: a failed or cancelled run, a run for some other
# commit, no run at all, a run that never finishes, or GitHub not answering.
#
#   scripts/ci-gate [--branch BRANCH] [COMMIT]   (default: HEAD)
#
# It reads one branch's run only (P-140): `--branch`, or the branch COMMIT names
# (`scripts/ci-gate main`), or the branch HEAD is on (/done's call). Never the
# newest run on any branch: another session's branch can point at the same
# commit, and its cancelled run once refused a deploy whose main run was green;
# the same rule would let a newer green run elsewhere cover a red one on main.
# A bare commit with no --branch, or a detached HEAD, names no branch: refused.
#
# Exit codes:
#   0  CI passed for this commit
#   1  CI did not pass (failed, cancelled, or ran for another commit)
#   2  CI never reported a run for this commit
#   3  CI didn't finish in time
#   4  couldn't reach or authenticate with GitHub, twice: the only case for
#      /done's manual path, and a bad token is the usual cause. The first time,
#      the gate waits and makes the same request once more (P-842), saying so.
#      A network failure gh reports (a TLS timeout, a reset connection) is this
#      case, even when GitHub answers a moment later (P-881).
#   5  GitHub answered, with an error (an HTTP status, a 5xx too, or text the
#      gate doesn't know): never a case for the manual path, never retried
#   6  no branch to read the run from: a bare commit needs --branch, and a
#      detached HEAD (a rebase stopped part way, say) has none
set -euo pipefail

say() { printf 'ci-gate: %s\n' "$*" >&2; }
not_merging() { say "Not fast-forwarding main. $*"; }

branch="" ref=""
while (($#)); do
  case "$1" in
    --branch) branch="${2:-}"; shift 2 || shift ;;
    --branch=*) branch="${1#--branch=}"; shift ;;
    -*) say "unknown option $1. Usage: scripts/ci-gate [--branch BRANCH] [COMMIT]"; exit 6 ;;
    *) ref="$1"; shift ;;
  esac
done
ref="${ref:-HEAD}"
sha="$(git rev-parse --verify "${ref}^{commit}")"
short="${sha:0:7}"
if [[ -z "$branch" ]]; then
  if [[ "$ref" == HEAD ]]; then
    branch="$(git symbolic-ref --quiet --short HEAD || true)"
  elif git show-ref --verify --quiet "refs/heads/$ref"; then
    branch="$ref"
  elif [[ "$ref" == origin/* ]] && git show-ref --verify --quiet "refs/remotes/$ref"; then
    branch="${ref#origin/}"
  fi
fi
if [[ -z "$branch" ]]; then
  not_merging "no branch to read CI from for $short: a bare commit needs --branch, and a detached HEAD (a rebase stopped part way?) has none."
  exit 6
fi
# The workflow's `name:` in .github/workflows/ci.yml. Matched by name, not with
# `gh run list --workflow ci.yml`: GitHub resolves that against the default
# branch, so it 404s until the workflow file is on main.
workflow="${CI_GATE_WORKFLOW_NAME:-CI}"
appear_timeout="${CI_GATE_APPEAR_TIMEOUT:-180}"  # seconds for the run to show up
# How long a run may take, in seconds (P-882). 35 minutes: since T-9.11's
# accessibility walk joined the E2E, a branch's whole run took 21 to 25 minutes
# (four runs, 18-19 October 2026; 12 to 18 before it), its E2E starting only
# once the API's job is done, so 20 minutes exited 3 on runs that went green.
# Shortening the walk is P-866; lowering this after it, measured, is P-883.
FINISH_TIMEOUT_DEFAULT=2100
finish_timeout="${CI_GATE_FINISH_TIMEOUT:-$FINISH_TIMEOUT_DEFAULT}"
interval="${CI_GATE_INTERVAL:-10}"
retry_wait="${CI_GATE_RETRY_WAIT:-30}" # seconds before the one more try (P-842)
retried=0
errors="$(mktemp)"
trap 'rm -f "$errors"' EXIT

# gh failed. Tell "couldn't reach or authenticate" (exit 4) apart from "GitHub
# answered with an error" (exit 5), so an ordinary 404 can never open the
# manual path. The first "couldn't reach" waits and returns, and the caller
# makes the same request again (P-842: a moment's trouble, seen on 4, 14 and 18
# October 2026, cleared each time on the same run); it is said, with the time,
# so each one is on the record. The second is final. Exit 5 is never retried.
# What gh prints when a request got no answer at all (P-881): Go's transport
# errors, and gh's own "error connecting to". Read only when no HTTP status is
# in the text: a status means GitHub answered, whatever else the text says.
NETWORK_ERRORS='TLS handshake timeout|connection reset|connection refused|no such host|i/o timeout|Client\.Timeout exceeded|unexpected EOF|error connecting to'

gh_failed() {
  local what="$1" why=""
  if ! grep -qE 'HTTP [0-9]{3}' "$errors" && grep -qE "$NETWORK_ERRORS" "$errors"; then
    why="a network error: $(grep -m1 -E "$NETWORK_ERRORS" "$errors")"
  elif ! gh api rate_limit >/dev/null 2>&1; then
    why="'gh api rate_limit' fails too"
  fi
  if [[ -n "$why" ]]; then
    if ((retried == 0)); then
      retried=1
      say "couldn't reach GitHub while $what at $(date -u +%FT%TZ); trying once more in ${retry_wait}s (P-842)."
      sleep "$retry_wait"
      return 0
    fi
    not_merging "couldn't reach or authenticate with GitHub, and once more after ${retry_wait}s, while $what ($why)."
    say "Check the token first: 'gh auth status'. If it's expired or missing, 'gh auth login' and run scripts/ci-gate again."
    exit 4
  fi
  not_merging "GitHub answered with an error while $what:"
  sed 's/^/ci-gate:   /' "$errors" >&2
  exit 5
}

# The run for exactly this commit, this workflow and this branch: gh filters by
# SHA and branch, and jq checks all three again. Never "the latest run on the
# branch" — between a push and its run appearing, that is an older commit's.
find_run() {
  gh run list --commit "$sha" --branch "$branch" --event push --limit 50 \
    --json databaseId,headSha,headBranch,workflowName,createdAt \
    --jq "[.[] | select(.headSha == \"$sha\" and .headBranch == \"$branch\" and .workflowName == \"$workflow\")] | sort_by(.createdAt) | last | .databaseId // empty"
}

say "waiting for the '${workflow}' workflow on ${short}, on ${branch}…"
start=$SECONDS
while :; do
  if ! run="$(find_run 2>"$errors")"; then
    gh_failed "listing runs for $short"
    continue
  fi
  if [[ -n "$run" ]]; then break; fi
  if ((SECONDS - start >= appear_timeout)); then
    not_merging "CI never reported a run for $short on $branch within ${appear_timeout}s."
    say "Decide: look at the Actions tab, re-run, or wait and run scripts/ci-gate again."
    exit 2
  fi
  sleep "$interval"
done

say "run $run is for $short; waiting up to ${finish_timeout}s for it to finish…"
start=$SECONDS
while :; do
  if ! line="$(gh run view "$run" --json status,conclusion,headSha,headBranch \
    --jq '"\(.status)|\(.conclusion)|\(.headSha)|\(.headBranch)"' 2>"$errors")"; then
    gh_failed "reading run $run"
    continue
  fi
  IFS='|' read -r status conclusion head run_branch <<<"$line"
  if [[ "$head" != "$sha" ]]; then
    not_merging "run $run is for ${head:0:7}, not $short."
    exit 1
  fi
  if [[ "$run_branch" != "$branch" ]]; then
    not_merging "run $run ran on $run_branch, not $branch."
    exit 1
  fi
  if [[ "$status" == completed ]]; then
    if [[ "$conclusion" == success ]]; then
      say "CI is green for $short (run $run)."
      exit 0
    fi
    not_merging "CI concluded '${conclusion:-none}' for $short (run $run)."
    say "See why: gh run view $run --log-failed"
    exit 1
  fi
  if ((SECONDS - start >= finish_timeout)); then
    not_merging "run $run for $short didn't finish within ${finish_timeout}s. Decide."
    exit 3
  fi
  sleep "$interval"
done
