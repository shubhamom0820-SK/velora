#!/usr/bin/env bash
# Tests scripts/release-gate (T-2.6, D-075) against a fake `gh` and a fake
# `curl` (Vercel's and Supabase's APIs), in a throwaway git repo, so "on main"
# is under test without depending on how deep a checkout is. The fake gh applies
# the gate's real --jq expressions with jq, as gh does. Every case checks the
# message as well as the exit code. Runs locally and in CI.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
gate="$here/release-gate"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

now=1790000000 # 2026-09-21, pinned through RELEASE_GATE_NOW
day=86400
token="vercel-test-token-0123456789abcdef"
sbtoken="sbp_supabase-test-token-fedcba9876543210"

# A repo with main two commits long, and a side commit that never merged.
repo="$work/repo"
git init -q -b main "$repo"
commit() { git -C "$repo" -c user.name=test -c user.email=test@example.com commit -q --allow-empty -m "$1"; }
commit first
commit second
sha="$(git -C "$repo" rev-parse HEAD)"
git -C "$repo" checkout -q -b side HEAD~1
commit side
side="$(git -C "$repo" rev-parse HEAD)"
git -C "$repo" checkout -q main
other="0000000000000000000000000000000000000000"

mkdir "$work/bin"
cat >"$work/bin/gh" <<'FAKE'
#!/usr/bin/env bash
set -euo pipefail
expr="" prev="" source=""
for arg in "$@"; do
  if [[ "$prev" == --jq ]]; then expr="$arg"; fi
  if [[ "$prev" == --commit ]]; then source=ci; fi
  if [[ "$prev" == --workflow ]]; then source=staging; fi
  prev="$arg"
done
if [[ -f "$FAKE_DIR/github-unreachable" ]]; then
  echo "error connecting to api.github.com" >&2
  exit 1
fi
case "$1 $2" in
  "api rate_limit") echo '{}'; exit 0 ;;
  "run list")
    if [[ -f "$FAKE_DIR/github-error" ]]; then cat "$FAKE_DIR/github-error" >&2; exit 1; fi
    json="$(cat "$FAKE_DIR/$source.json")"
    ;;
  *) echo "fake gh: unexpected call: $*" >&2; exit 64 ;;
esac
jq -r "$expr" <<<"$json"
FAKE
cat >"$work/bin/curl" <<'FAKE'
#!/usr/bin/env bash
# Vercel's and Supabase's APIs, faked. Each service's token must arrive on
# stdin, and neither token may ever be in the arguments.
set -euo pipefail
config="$(cat)"
for arg in "$@"; do
  if [[ "$arg" == *"$FAKE_TOKEN"* || "$arg" == *"$FAKE_SUPABASE_TOKEN"* ]]; then
    echo "A TOKEN IN CURL'S ARGUMENTS" >&2
    exit 99
  fi
done
out="" prev="" url=""
for arg in "$@"; do
  if [[ "$prev" == -o ]]; then out="$arg"; fi
  prev="$arg"
  url="$arg"
done
case "$url" in
  https://vercel.test/v5/user/tokens/current) service=vercel fixture=token want="$FAKE_TOKEN" ;;
  https://vercel.test/v2/teams/team_test) service=vercel fixture=team want="$FAKE_TOKEN" ;;
  https://supabase.test/v1/projects/prodref) service=supabase fixture=project want="$FAKE_SUPABASE_TOKEN" ;;
  https://supabase.test/v1/organizations/velora-prod-org) service=supabase fixture=org want="$FAKE_SUPABASE_TOKEN" ;;
  *) echo "fake curl: unexpected URL: $url" >&2; exit 64 ;;
esac
if [[ "$config" != *"Authorization: Bearer $want"* ]]; then
  echo "NOT $service's TOKEN ON STDIN" >&2
  exit 98
fi
echo "the token came on stdin" >"$FAKE_DIR/$service-token-on-stdin"
if [[ -f "$FAKE_DIR/$service-unreachable" ]]; then
  echo "curl: (6) Could not resolve host: $service.test" >&2
  exit 6
fi
cp "$FAKE_DIR/$fixture.json" "$out"
cat "$FAKE_DIR/$fixture-http"
FAKE
chmod +x "$work/bin/gh" "$work/bin/curl"

# ci_run ID SHA STATUS CONCLUSION CREATED_AT
ci_run() {
  printf '{"databaseId":%s,"headSha":"%s","workflowName":"CI","status":"%s","conclusion":"%s","createdAt":"%s"}' \
    "$1" "$2" "$3" "$4" "$5"
}
# staging_run ID DEPLOYED_SHA STATUS CONCLUSION CREATED_AT [RECORDED_HEAD_SHA]
staging_run() {
  printf '{"databaseId":%s,"displayTitle":"Deploy staging %s","headSha":"%s","status":"%s","conclusion":"%s","createdAt":"%s"}' \
    "$1" "$2" "${6:-$2}" "$3" "$4" "$5"
}
# A token answer expiring DAYS from now, or never with "null".
token_json() {
  if [[ "$1" == null ]]; then
    printf '{"token":{"id":"t1","expiresAt":null}}'
  else
    printf '{"token":{"id":"t1","expiresAt":%s}}' "$(((now + $1 * day) * 1000))"
  fi
}

# scenario NAME CI_JSON STAGING_JSON TOKEN_JSON HTTP — and every account answer
# green: a Pro team, velora-prod in its own organisation, on Pro. A case
# overrides a file with set_answer.
scenario() {
  local dir="$work/$1"
  mkdir -p "$dir"
  printf '%s' "$2" >"$dir/ci.json"
  printf '%s' "$3" >"$dir/staging.json"
  printf '%s' "$4" >"$dir/token.json"
  printf '%s' "$5" >"$dir/token-http"
  printf '%s' '{"id":"team_test","slug":"knot11","billing":{"plan":"pro"}}' >"$dir/team.json"
  printf '200' >"$dir/team-http"
  printf '%s' '{"ref":"prodref","organization_slug":"velora-prod-org"}' >"$dir/project.json"
  printf '200' >"$dir/project-http"
  printf '%s' '{"id":"o1","name":"Velora production","plan":"pro"}' >"$dir/org.json"
  printf '200' >"$dir/org-http"
}
# set_answer NAME FILE CONTENT
set_answer() { printf '%s' "$3" >"$work/$1/$2"; }
green() { scenario "$1" "[$(ci_run 11 "$sha" completed success 2026-09-20T00:00:00Z)]" \
  "[$(staging_run 21 "$sha" completed success 2026-09-20T01:00:00Z)]" "$(token_json 200)" 200; }

passed=0 failed=0
# expect NAME EXIT MESSAGE [ENV=VALUE]... — the default is a commit on main,
# every credential, and not running on GitHub; a case overrides what it needs.
expect() {
  local name="$1" want="$2" message="$3" got=0
  shift 3
  (cd "$repo" && env PATH="$work/bin:$PATH" FAKE_DIR="$work/$name" FAKE_TOKEN="$token" \
    FAKE_SUPABASE_TOKEN="$sbtoken" RELEASE_GATE_MAIN_REF=main RELEASE_GATE_NOW="$now" \
    RELEASE_GATE_VERCEL_API=https://vercel.test RELEASE_GATE_SUPABASE_API=https://supabase.test \
    VERCEL_TOKEN="$token" VERCEL_ORG_ID=team_test SUPABASE_ACCESS_TOKEN="$sbtoken" \
    SUPABASE_PROJECT_REF=prodref GITHUB_ACTIONS=false GITHUB_STEP_SUMMARY="$work/$name/summary.md" \
    COMMIT="$sha" "$@" bash -c '"$0" "$COMMIT"' "$gate") >"$work/$name.out" 2>&1 || got=$?
  if [[ "$got" == "$want" ]] && grep -qF -- "$message" "$work/$name.out"; then
    passed=$((passed + 1))
    printf 'ok    %-44s exit %s\n' "$name" "$got"
  else
    failed=$((failed + 1))
    printf 'FAIL  %-44s exit %s, want %s saying "%s"\n' "$name" "$got" "$want" "$message"
    sed 's/^/        /' "$work/$name.out"
  fi
}
# also NAME FILE TEXT: a second thing a case must have produced.
also() {
  if grep -qF -- "$3" "$work/$1/$2" 2>/dev/null || grep -qF -- "$3" "$work/$1.$2" 2>/dev/null; then
    passed=$((passed + 1))
    printf 'ok    %-44s %s\n' "$1" "$2 has it"
  else
    failed=$((failed + 1))
    printf 'FAIL  %-44s %s lacks "%s"\n' "$1" "$2" "$3"
  fi
}

# --- all three checks pass, and the token has a long while left
green all-green
expect all-green 0 "Production may take ${sha:0:7}."
also all-green out "ok   staging deployed ${sha:0:7} and its smoke check passed (run 21)."
also all-green out "expires on 2027-04-09, in 200 days."
also all-green vercel-token-on-stdin "the token came on stdin"
also all-green supabase-token-on-stdin "the token came on stdin"
also all-green out "ok   the Vercel team is on pro."
also all-green out "ok   velora-prod's organisation (velora-prod-org) is on pro, with daily backups."

# --- 1. on main
green not-on-main
expect not-on-main 1 "Not releasing ${side:0:7}. It isn't on main: production takes only commits that merged (D-075)." \
  COMMIT="$side"

green main-not-fetched
expect main-not-fetched 1 "Can't see origin/main to check the commit is on main: fetch it first." \
  RELEASE_GATE_MAIN_REF=origin/main

# --- 2. CI for this exact commit
scenario ci-never-ran "[]" "[$(staging_run 21 "$sha" completed success 2026-09-20T01:00:00Z)]" "$(token_json 200)" 200
expect ci-never-ran 1 "Not releasing ${sha:0:7}. CI never ran for it."

scenario ci-failed "[$(ci_run 11 "$sha" completed failure 2026-09-20T00:00:00Z)]" \
  "[$(staging_run 21 "$sha" completed success 2026-09-20T01:00:00Z)]" "$(token_json 200)" 200
expect ci-failed 1 "CI concluded 'failure' for it (run 11)."

scenario ci-unfinished "[$(ci_run 11 "$sha" in_progress "" 2026-09-20T00:00:00Z)]" \
  "[$(staging_run 21 "$sha" completed success 2026-09-20T01:00:00Z)]" "$(token_json 200)" 200
expect ci-unfinished 1 "CI run 11 hasn't finished (in_progress). Release once it has passed."

# A newer, failing run for another commit sits beside ours: ours is the one.
scenario ci-picks-this-commit "[$(ci_run 12 "$other" completed failure 2026-09-20T05:00:00Z),$(ci_run 11 "$sha" completed success 2026-09-20T00:00:00Z)]" \
  "[$(staging_run 21 "$sha" completed success 2026-09-20T01:00:00Z)]" "$(token_json 200)" 200
expect ci-picks-this-commit 0 "ok   CI passed for ${sha:0:7} (run 11)."

# Two runs for this commit: the newest counts, as in ci-gate.
scenario ci-newest-counts "[$(ci_run 11 "$sha" completed success 2026-09-20T00:00:00Z),$(ci_run 12 "$sha" completed failure 2026-09-20T05:00:00Z)]" \
  "[$(staging_run 21 "$sha" completed success 2026-09-20T06:00:00Z)]" "$(token_json 200)" 200
expect ci-newest-counts 1 "CI concluded 'failure' for it (run 12)."

# --- 3. staging deployed this exact commit
scenario staging-never-deployed "[$(ci_run 11 "$sha" completed success 2026-09-20T00:00:00Z)]" \
  "[$(staging_run 21 "$other" completed success 2026-09-20T01:00:00Z)]" "$(token_json 200)" 200
expect staging-never-deployed 1 "Staging never deployed it: production only gets what staging proved (D-075)."

# The trap: GitHub recorded our commit on a deploy run that deployed another one
# (a workflow_run's headSha is main's head when it started). It must not count.
scenario staging-recorded-not-deployed "[$(ci_run 11 "$sha" completed success 2026-09-20T00:00:00Z)]" \
  "[$(staging_run 21 "$other" completed success 2026-09-20T01:00:00Z "$sha")]" "$(token_json 200)" 200
expect staging-recorded-not-deployed 1 "Staging never deployed it"

scenario staging-failed "[$(ci_run 11 "$sha" completed success 2026-09-20T00:00:00Z)]" \
  "[$(staging_run 21 "$sha" completed failure 2026-09-20T01:00:00Z)]" "$(token_json 200)" 200
expect staging-failed 1 "Staging's deploy of it concluded 'failure' (run 21)"

scenario staging-unfinished "[$(ci_run 11 "$sha" completed success 2026-09-20T00:00:00Z)]" \
  "[$(staging_run 21 "$sha" in_progress "" 2026-09-20T01:00:00Z)]" "$(token_json 200)" 200
expect staging-unfinished 1 "Staging's deploy of it (run 21) hasn't finished (in_progress)."

# --- 4. the production Vercel token
green token-30-days
printf '%s' "$(token_json 30)" >"$work/token-30-days/token.json"
expect token-30-days 0 "ok   the production Vercel token expires on 2026-10-21, in 30 days."

green token-29-days
printf '%s' "$(token_json 29)" >"$work/token-29-days/token.json"
expect token-29-days 0 "WARNING: The production Vercel token expires on 2026-10-20, in 29 days."
also token-29-days out "Production may take ${sha:0:7}."

# On GitHub, the warning is an annotation and a line in the run's summary.
green token-warns-on-github
printf '%s' "$(token_json 10)" >"$work/token-warns-on-github/token.json"
expect token-warns-on-github 0 "::warning title=Production Vercel token::The production Vercel token expires on 2026-10-01, in 10 days." \
  GITHUB_ACTIONS=true
also token-warns-on-github summary.md "> **Warning:** The production Vercel token expires on 2026-10-01, in 10 days."

green token-expired
printf '%s' "$(token_json -1)" >"$work/token-expired/token.json"
expect token-expired 1 "The production Vercel token expired on 2026-09-20."

green token-refused
printf '403' >"$work/token-refused/token-http"
expect token-refused 1 "Vercel refuses the production token (HTTP 403): it has expired or been revoked."

green token-never-expires
printf '%s' "$(token_json null)" >"$work/token-never-expires/token.json"
expect token-never-expires 0 "WARNING: The production Vercel token never expires."

green token-missing-on-github
expect token-missing-on-github 1 "The production environment has no VERCEL_TOKEN, so the web can't deploy" \
  VERCEL_TOKEN= GITHUB_ACTIONS=true

green token-missing-by-hand
expect token-missing-by-hand 0 "no production credentials here, so the token and the paid plans aren't read" VERCEL_TOKEN=

green vercel-unreachable
touch "$work/vercel-unreachable/vercel-unreachable"
expect vercel-unreachable 4 "Couldn't reach Vercel to read the production token"

green vercel-error
printf '500' >"$work/vercel-error/token-http"
expect vercel-error 5 "Vercel answered HTTP 500 while reading the production token."

# --- 5. the Vercel team's plan (P-0.15): an allowlist of paid plans
green vercel-hobby
set_answer vercel-hobby team.json '{"id":"team_test","billing":{"plan":"hobby"}}'
expect vercel-hobby 1 "The Vercel team is on Hobby, which Vercel's terms limit to non-commercial use, and a public dating app is commercial. Upgrade it to Pro first (P-0.15)."

green vercel-enterprise
set_answer vercel-enterprise team.json '{"id":"team_test","billing":{"plan":"enterprise"}}'
expect vercel-enterprise 0 "ok   the Vercel team is on enterprise."

green vercel-unknown-plan
set_answer vercel-unknown-plan team.json '{"id":"team_test","billing":{"plan":"startup"}}'
expect vercel-unknown-plan 1 "The Vercel team is on 'startup', a plan this gate doesn't know: it allows pro and enterprise (P-0.15)."

green vercel-no-plan
set_answer vercel-no-plan team.json '{"id":"team_test"}'
expect vercel-no-plan 1 "Vercel's answer for the team says no plan, so it can't be checked (P-0.15)."

green vercel-team-error
set_answer vercel-team-error team-http 404
expect vercel-team-error 5 "Vercel answered HTTP 404 while reading the team's plan."

green org-id-missing-on-github
expect org-id-missing-on-github 1 "The production environment has no VERCEL_ORG_ID, so the Vercel team's plan can't be read" \
  VERCEL_ORG_ID= GITHUB_ACTIONS=true

# --- 6. velora-prod's Supabase plan (P-0.16), through the project
green supabase-free
set_answer supabase-free org.json '{"id":"o1","plan":"free"}'
expect supabase-free 1 "velora-prod's Supabase organisation (velora-prod-org) is on Free, which keeps no backups, and the first real sign-up is the first thing worth losing. Upgrade it to Pro first (P-0.16)."

green supabase-team
set_answer supabase-team org.json '{"id":"o1","plan":"team"}'
expect supabase-team 0 "ok   velora-prod's organisation (velora-prod-org) is on team, with daily backups."

# A plan this gate doesn't know is refused, never assumed to keep backups.
green supabase-unknown-plan
set_answer supabase-unknown-plan org.json '{"id":"o1","plan":"platform"}'
expect supabase-unknown-plan 1 "is on 'platform', a plan this gate doesn't know: it allows pro, team and enterprise (P-0.16)."

# The schema doesn't require the field: its absence is a refusal, not a pass.
green supabase-no-plan
set_answer supabase-no-plan org.json '{"id":"o1","name":"Velora production"}'
expect supabase-no-plan 1 "Supabase didn't say which plan velora-prod's organisation (velora-prod-org) is on, so its backups can't be confirmed (P-0.16)."

green supabase-no-org
set_answer supabase-no-org project.json '{"ref":"prodref"}'
expect supabase-no-org 1 "Supabase's answer for project prodref names no organisation, so its plan can't be checked (P-0.16)."

green supabase-token-refused
set_answer supabase-token-refused project-http 401
expect supabase-token-refused 1 "Supabase refuses the production token (HTTP 401): it has expired or been revoked, or it can't read velora-prod and its organisation. Create a scoped, read-only token for them, never a classic one"

green supabase-unreachable
touch "$work/supabase-unreachable/supabase-unreachable"
expect supabase-unreachable 4 "Couldn't reach Supabase to read velora-prod"

green supabase-error
set_answer supabase-error org-http 500
expect supabase-error 5 "Supabase answered HTTP 500 while reading the organisation's plan."

green supabase-token-missing-on-github
expect supabase-token-missing-on-github 1 "The production environment has no SUPABASE_ACCESS_TOKEN, so velora-prod's plan can't be read" \
  SUPABASE_ACCESS_TOKEN= GITHUB_ACTIONS=true

green project-ref-missing-on-github
expect project-ref-missing-on-github 1 "The production environment has no SUPABASE_PROJECT_REF, so velora-prod can't be found" \
  SUPABASE_PROJECT_REF= GITHUB_ACTIONS=true

# --- GitHub itself
green github-unreachable
touch "$work/github-unreachable/github-unreachable"
expect github-unreachable 4 "Couldn't reach or authenticate with GitHub while listing CI runs"

green github-error
echo "HTTP 404: Not Found (https://api.github.com/repos/o/r/actions/runs)" >"$work/github-error/github-error"
expect github-error 5 "GitHub answered with an error while listing CI runs"
also github-error out "HTTP 404: Not Found"

echo "release-gate-test: $passed passed, $failed failed"
((failed == 0))
