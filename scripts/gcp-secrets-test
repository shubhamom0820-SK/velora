#!/usr/bin/env bash
# Tests scripts/gcp-secrets (P-49) without touching the Keychain, gcloud or Fly:
# its helpers and its production prompt loop, taken from the script as written,
# with storage replaced by stubs that only print a prefix. The loop's fields are
# split on |, because the URL checks contain ':' (the advisor's catch, 18 October
# 2026: split on ':', "postgresql+asyncpg://*" became "postgresql+asyncpg" and
# every real URL was refused). Every case checks what was stored or refused.
# Runs locally and in CI.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
script="$here/gcp-secrets"
failures=0
fail() {
  echo "gcp-secrets-test: FAIL $*"
  failures=$((failures + 1))
}
ok() { echo "gcp-secrets-test: ok   $*"; }

# The helpers, from `say() {` to the first section line, and the production
# prompt loop, from its heading to the Sentry prompt after it.
helpers="$(sed -n '/^say() {/,/^# ------/p' "$script" | sed '/^# ------/d')"
loop="$(awk '/^  say "=== production: values only you have/{f=1; next} f && /^  if ask SENTRY_DSN/{exit} f' "$script")"
[[ -n "$helpers" ]] || fail "no helpers found in gcp-secrets"
[[ "$loop" == *"for spec in"* ]] || fail "no production prompt loop found in gcp-secrets"

# run ANSWERS...: the loop with these answers at its seven prompts, in a shell of
# its own, with the Keychain empty and both stores stubbed.
run() {
  local answers
  answers="$(printf '%s\n' "$@")"
  bash -c "
    set -uo pipefail
    $helpers
    kc_has() { return 1; }
    kc_put() { echo \"STORED-KC \$1 \$(printf '%s' \"\$2\" | pfx)\"; }
    to_sm() { echo \"STORED-SM \$1 \$(printf '%s' \"\$2\" | pfx)\"; }
    FAILED=0; ASKED=''
    $loop
  " <<<"$answers" 2>&1
}
prefix() { printf '%s' "$1" | shasum -a 256 | cut -c1-8; }

good_db='postgresql+asyncpg://velora_api:pw@db.example.supabase.co:5432/postgres?ssl=require'
good_redis='rediss://default:tok@example.upstash.io:6379'
out="$(run "$good_db" "$good_redis" "rzp_live_abc" "" "" "" "")"
if [[ "$out" == *"STORED-KC database-url $(prefix "$good_db")"* && "$out" == *"STORED-SM DATABASE_URL $(prefix "$good_db")"* ]]; then
  ok "a real postgresql+asyncpg:// URL is stored in both places"
else fail "a good DATABASE_URL wasn't stored: $out"; fi
if [[ "$out" == *"STORED-SM REDIS_URL $(prefix "$good_redis")"* ]]; then
  ok "a real rediss:// URL is stored"
else fail "a good REDIS_URL wasn't stored: $out"; fi
if [[ "$out" == *"STORED-SM RAZORPAY_KEY_ID $(prefix rzp_live_abc)"* ]]; then
  ok "an rzp_ key id is stored"
else fail "a good RAZORPAY_KEY_ID wasn't stored: $out"; fi
skipped="$(grep -c ': skipped$' <<<"$out" || true)"
if [[ "$skipped" == 4 ]]; then ok "Enter skips, four times"; else fail "expected 4 skips, saw $skipped: $out"; fi
if [[ "$out" != *FAILED* ]]; then ok "nothing refused among good answers"; else fail "a good answer was refused: $out"; fi

out="$(run 'postgres://velora_api:pw@db.example/postgres' 'redis://plain.example:6379' 'key_without_prefix' "" "" "" "")"
if [[ "$out" == *"FAILED: DATABASE_URL: not the expected shape (postgresql+asyncpg://*); nothing stored"* ]]; then
  ok "a postgres:// URL is refused, naming the shape"
else fail "a bad DATABASE_URL wasn't refused as expected: $out"; fi
if [[ "$out" == *"FAILED: REDIS_URL: not the expected shape (rediss://*); nothing stored"* ]]; then
  ok "a plain redis:// URL is refused"
else fail "a bad REDIS_URL wasn't refused as expected: $out"; fi
if [[ "$out" == *"FAILED: RAZORPAY_KEY_ID: not the expected shape (rzp_*)"* ]]; then
  ok "a key id without rzp_ is refused"
else fail "a bad RAZORPAY_KEY_ID wasn't refused: $out"; fi
if [[ "$out" != *STORED-* ]]; then ok "nothing refused was stored"; else fail "a refused value was stored: $out"; fi

# The production comparison, from its heading to the Apple Passwords line, with
# every store stubbed: Secret Manager empty for SENTRY_DSN and the VAPID pair,
# every other name the same everywhere. SENTRY_DSN is required (T-9.12, D-1001):
# the VM's deploy stops without it, so an empty slot must say so, never
# "optional"; only the VAPID pair may be empty (push is off, D-857).
compare="$(awk '/^  say "=== production: every copy compared/{f=1} f && /^  say "Next, by hand/{exit} f' "$script")"
[[ "$compare" == *"for name in"* ]] || fail "no production comparison found in gcp-secrets"
out="$(bash -c "
  set -uo pipefail
  $helpers
  sm_pfx() { case \"\$1\" in SENTRY_DSN|VAPID_*) printf -- - ;; *) if [ \"\${2:-}\" = velora-ic-staging ]; then printf 0000aaaa; else printf 1111bbbb; fi ;; esac; }
  kc_pfx() { printf 1111bbbb; }
  FAILED=0
  $compare
" 2>&1)"
if grep -q "^SENTRY_DSN .*not set yet: production can't deploy without it" <<<"$out"; then
  ok "an empty SENTRY_DSN says production can't deploy without it"
else
  fail "an empty SENTRY_DSN wasn't called required: $out"
fi
if [[ "$(grep -c '^VAPID_.*empty (optional)' <<<"$out")" == 2 ]]; then
  ok "an empty VAPID pair is still optional"
else
  fail "the VAPID pair's verdict changed: $out"
fi
if [[ "$out" != *"SENTRY_DSN"*"optional"* ]]; then ok "SENTRY_DSN is never called optional"; else fail "SENTRY_DSN called optional: $out"; fi

# The Keychain line can't carry a space, a quote or a backslash safely.
out="$(bash -c "$helpers"$'\n'"KC=none; FAILED=0; kc_put t 'has space'; kc_put t 'q\"uote'; kc_put t 'back\\\\slash'" 2>&1 || true)"
if [[ "$(grep -c 'holds a space, quote or backslash' <<<"$out")" == 3 ]]; then
  ok "kc_put refuses spaces, quotes and backslashes before writing"
else
  fail "kc_put let an unsafe value through: $out"
fi

if ((failures > 0)); then
  echo "gcp-secrets-test: $failures case(s) failed."
  exit 1
fi
echo "gcp-secrets-test: every case passed."
