#!/usr/bin/env bash
# Tests scripts/ci-gate against a fake `gh` (T-1.20): the gate passes only a
# successful run for the exact commit, and fails closed on everything else.
# The fake applies the gate's real --jq expressions with jq, as gh does, so the
# exact-SHA filtering is what's under test. Runs locally and in CI.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
gate="$here/ci-gate"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

sha="$(git -C "$here" rev-parse HEAD)"
old="0000000000000000000000000000000000000000"

mkdir "$work/bin"
cat >"$work/bin/gh" <<'FAKE'
#!/usr/bin/env bash
set -euo pipefail
expr="" prev=""
for arg in "$@"; do
  if [[ "$prev" == --jq ]]; then expr="$arg"; fi
  prev="$arg"
done
# GitHub resolves --workflow against the default branch, so it 404s until the
# workflow file is on main (T-1.20's first run). The fake always does, so the
# flag can't quietly come back.
for arg in "$@"; do
  if [[ "$arg" == --workflow ]]; then
    echo "HTTP 404: workflow ci.yml not found on the default branch" >&2
    exit 1
  fi
done
if [[ -f "$FAKE_DIR/unreachable" ]]; then
  echo "error connecting to api.github.com" >&2
  exit 1
fi
# A token GitHub refuses: every call, rate_limit too, answered with a 401.
if [[ -f "$FAKE_DIR/bad-token" ]]; then
  echo "HTTP 401: Bad credentials (https://api.github.com/rate_limit)" >&2
  exit 1
fi
# A moment's trouble while a run is read (P-842): the next N reads of the run,
# and the rate_limit check each failure makes, can't reach GitHub.
if [[ -f "$FAKE_DIR/unreachable-reads" ]] && [[ "$1 $2" == "run view" || "$1 $2" == "api rate_limit" ]]; then
  left="$(cat "$FAKE_DIR/unreachable-reads")"
  if ((left > 0)); then
    echo $((left - 1)) >"$FAKE_DIR/unreachable-reads"
    echo "error connecting to api.github.com" >&2
    exit 1
  fi
fi
# A read of the run that fails with gh's own error text, while GitHub itself
# answers rate_limit (P-881): the next N reads print view-error and fail.
if [[ -f "$FAKE_DIR/view-error-reads" ]] && [[ "$1 $2" == "run view" ]]; then
  left="$(cat "$FAKE_DIR/view-error-reads")"
  if ((left > 0)); then
    echo $((left - 1)) >"$FAKE_DIR/view-error-reads"
    cat "$FAKE_DIR/view-error" >&2
    exit 1
  fi
fi
case "$1 $2" in
  "api rate_limit") echo '{}'; exit 0 ;;
  "run list")
    if [[ -f "$FAKE_DIR/list-error" ]]; then cat "$FAKE_DIR/list-error" >&2; exit 1; fi
    calls=$(($(cat "$FAKE_DIR/list-calls" 2>/dev/null || echo 0) + 1))
    echo "$calls" >"$FAKE_DIR/list-calls"
    if ((calls <= $(cat "$FAKE_DIR/delay" 2>/dev/null || echo 0))); then
      json='[]'
    else
      json="$(cat "$FAKE_DIR/list.json")"
    fi
    ;;
  "run view") json="$(cat "$FAKE_DIR/view-$3.json")" ;;
  *) echo "fake gh: unexpected call: $*" >&2; exit 64 ;;
esac
jq -r "$expr" <<<"$json"
FAKE
chmod +x "$work/bin/gh"

# The branch every scenario's runs are on unless it says otherwise; expect
# gates on it, as /done does on its task branch.
branch=feature

# scenario NAME LIST_JSON [RUN_ID VIEW_STATUS VIEW_CONCLUSION VIEW_SHA [VIEW_BRANCH]]...
# (groups of five; VIEW_BRANCH defaults to $branch)
scenario() {
  local dir="$work/$1"
  mkdir -p "$dir"
  printf '%s' "$2" >"$dir/list.json"
  shift 2
  while (($# >= 5)); do
    printf '{"status":"%s","conclusion":"%s","headSha":"%s","headBranch":"%s"}' "$2" "$3" "$4" "${5:-$branch}" >"$dir/view-$1.json"
    shift 5
  done
}
# run ID SHA CREATED_AT [WORKFLOW_NAME] [BRANCH]
run() { printf '{"databaseId":%s,"headSha":"%s","createdAt":"%s","workflowName":"%s","headBranch":"%s"}' "$1" "$2" "$3" "${4:-CI}" "${5:-$branch}"; }

# expect NAME EXIT MESSAGE [ENV=VALUE]... — the exit code alone can't tell a
# deliberate "not green" from the script crashing, so the message is checked too.
# The gate reads $branch's run for $sha. expect_in DIR NAME EXIT MESSAGE ARGS...
# runs it from DIR with ARGS instead, for how it finds its branch on its own.
passed=0 failed=0
expect() {
  local name="$1" want="$2" message="$3"
  shift 3
  check "$name" "$want" "$message" "$here" env "$@" "$gate" --branch "$branch" "$sha"
}
expect_in() {
  local dir="$1" name="$2" want="$3" message="$4"
  shift 4
  check "$name" "$want" "$message" "$dir" "$gate" "$@"
}
check() {
  local name="$1" want="$2" message="$3" dir="$4" got=0
  shift 4
  (cd "$dir" && env PATH="$work/bin:$PATH" FAKE_DIR="$work/$name" CI_GATE_INTERVAL=1 \
    CI_GATE_APPEAR_TIMEOUT=2 CI_GATE_FINISH_TIMEOUT=2 CI_GATE_RETRY_WAIT=1 "$@") >"$work/$name.out" 2>&1 || got=$?
  if [[ "$got" == "$want" ]] && grep -qF -- "$message" "$work/$name.out"; then
    passed=$((passed + 1))
    printf 'ok    %-48s exit %s\n' "$name" "$got"
  else
    failed=$((failed + 1))
    printf 'FAIL  %-48s exit %s, want %s saying "%s"\n' "$name" "$got" "$want" "$message"
    sed 's/^/        /' "$work/$name.out"
  fi
}

scenario green "[$(run 11 "$sha" 2026-01-01T00:00:00Z)]" 11 completed success "$sha" ""
expect green 0 "CI is green for ${sha:0:7} (run 11)"

# The wait for a run, unset (P-882): 35 minutes, since T-9.11's walk made a
# branch's whole run 21 to 25. The literal, never the script's constant.
scenario default-wait "[$(run 11 "$sha" 2026-01-01T00:00:00Z)]" 11 completed success "$sha" ""
expect default-wait 0 "waiting up to 2100s for it to finish" CI_GATE_FINISH_TIMEOUT=

scenario appears-late "[$(run 11 "$sha" 2026-01-01T00:00:00Z)]" 11 completed success "$sha" ""
echo 2 >"$work/appears-late/delay"
expect appears-late 0 "CI is green for ${sha:0:7} (run 11)" CI_GATE_APPEAR_TIMEOUT=6

# A newer run for an older commit sits beside ours: the gate must take ours.
scenario picks-this-commit "[$(run 9 "$old" 2026-01-02T00:00:00Z),$(run 11 "$sha" 2026-01-01T00:00:00Z)]" \
  9 completed failure "$old" "" 11 completed success "$sha" ""
expect picks-this-commit 0 "CI is green for ${sha:0:7} (run 11)"

scenario only-an-older-commit "[$(run 9 "$old" 2026-01-02T00:00:00Z)]" 9 completed success "$old" ""
expect only-an-older-commit 2 "CI never reported a run for ${sha:0:7} on $branch"

scenario no-run-at-all "[]"
expect no-run-at-all 2 "CI never reported a run for ${sha:0:7} on $branch"

scenario failed "[$(run 11 "$sha" 2026-01-01T00:00:00Z)]" 11 completed failure "$sha" ""
expect failed 1 "CI concluded 'failure'"

scenario cancelled "[$(run 11 "$sha" 2026-01-01T00:00:00Z)]" 11 completed cancelled "$sha" ""
expect cancelled 1 "CI concluded 'cancelled'"

scenario view-is-another-commit "[$(run 11 "$sha" 2026-01-01T00:00:00Z)]" 11 completed success "$old" ""
expect view-is-another-commit 1 "run 11 is for 0000000, not ${sha:0:7}"

scenario never-finishes "[$(run 11 "$sha" 2026-01-01T00:00:00Z)]" 11 in_progress "" "$sha" ""
expect never-finishes 3 "didn't finish within 2s"

# GitHub's own "Dependency Graph" workflow also runs on pushed commits.
scenario picks-this-workflow "[$(run 5 "$sha" 2026-01-02T00:00:00Z "Dependency Graph"),$(run 11 "$sha" 2026-01-01T00:00:00Z)]" \
  5 completed failure "$sha" "" 11 completed success "$sha" ""
expect picks-this-workflow 0 "CI is green for ${sha:0:7} (run 11)"

# --- One branch's run only (P-140) ---------------------------------------------
# Another session's branch can point at the same commit. Its runs never count.

# The hole nobody had seen: main's run is red, and a newer green run for the
# same commit sits on another branch. The deploy's gate must still refuse.
scenario main-red-newer-green-elsewhere \
  "[$(run 11 "$sha" 2026-01-01T00:00:00Z CI main),$(run 12 "$sha" 2026-01-02T00:00:00Z CI docs-other)]" \
  11 completed failure "$sha" main 12 completed success "$sha" docs-other
check main-red-newer-green-elsewhere 1 "CI concluded 'failure' for ${sha:0:7} (run 11)" "$here" "$gate" --branch main "$sha"

# What was seen (P-140): main's run green, a newer cancelled one elsewhere.
scenario main-green-newer-cancelled-elsewhere \
  "[$(run 11 "$sha" 2026-01-01T00:00:00Z CI main),$(run 13 "$sha" 2026-01-03T00:00:00Z CI docs-other)]" \
  11 completed success "$sha" main 13 completed cancelled "$sha" docs-other
check main-green-newer-cancelled-elsewhere 0 "CI is green for ${sha:0:7} (run 11)" "$here" "$gate" --branch main "$sha"

scenario only-another-branch-ran "[$(run 12 "$sha" 2026-01-02T00:00:00Z CI docs-other)]" \
  12 completed success "$sha" docs-other
check only-another-branch-ran 2 "CI never reported a run for ${sha:0:7} on main" "$here" "$gate" --branch main "$sha"

scenario view-is-another-branch "[$(run 11 "$sha" 2026-01-01T00:00:00Z CI main)]" \
  11 completed success "$sha" docs-other
check view-is-another-branch 1 "run 11 ran on docs-other, not main" "$here" "$gate" --branch main "$sha"

# No branch to read: a bare commit, or a detached HEAD. Refused, never guessed.
scenario bare-commit-names-no-branch "[$(run 11 "$sha" 2026-01-01T00:00:00Z)]" 11 completed success "$sha" ""
check bare-commit-names-no-branch 6 "no branch to read CI from for ${sha:0:7}" "$here" "$gate" "$sha"

# How /done and the manual path find their branch, in a repository of its own.
repo="$work/repo"
git init -q -b main "$repo"
git -C "$repo" -c user.name=t -c user.email=t@t commit -q --allow-empty -m one
git -C "$repo" checkout -q -b feature-x
rsha="$(git -C "$repo" rev-parse HEAD)"
scenario head-names-its-branch "[$(run 11 "$rsha" 2026-01-01T00:00:00Z CI feature-x),$(run 12 "$rsha" 2026-01-02T00:00:00Z CI main)]" \
  11 completed success "$rsha" feature-x 12 completed failure "$rsha" main
expect_in "$repo" head-names-its-branch 0 "CI is green for ${rsha:0:7} (run 11)"
scenario ref-names-its-branch "[$(run 11 "$rsha" 2026-01-01T00:00:00Z CI feature-x),$(run 12 "$rsha" 2026-01-02T00:00:00Z CI main)]" \
  11 completed success "$rsha" feature-x 12 completed failure "$rsha" main
expect_in "$repo" ref-names-its-branch 1 "CI concluded 'failure' for ${rsha:0:7} (run 12)" main
git -C "$repo" checkout -q --detach
scenario detached-head-names-no-branch "[$(run 11 "$rsha" 2026-01-01T00:00:00Z CI feature-x)]" \
  11 completed success "$rsha" feature-x
expect_in "$repo" detached-head-names-no-branch 6 "a detached HEAD (a rebase stopped part way?) has none"

# retried NAME TIMES: the gate's "trying once more" line appears exactly TIMES.
retried() {
  local got
  got="$(grep -c "trying once more in 1s (P-842)" "$work/$1.out" || true)"
  if [[ "$got" == "$2" ]]; then
    passed=$((passed + 1))
    printf 'ok    %-48s retried %s\n' "$1" "$got"
  else
    failed=$((failed + 1))
    printf 'FAIL  %-48s retried %s times, want %s\n' "$1" "$got" "$2"
  fi
}

scenario github-unreachable "[]"
touch "$work/github-unreachable/unreachable"
expect github-unreachable 4 "couldn't reach or authenticate with GitHub, and once more after 1s"
retried github-unreachable 1

# A refused token: GitHub answers 401, and rate_limit fails too, so "couldn't
# authenticate", exit 4, after the one more try.
scenario bad-token "[]"
touch "$work/bad-token/bad-token"
expect bad-token 4 "couldn't reach or authenticate with GitHub, and once more after 1s, while listing runs for ${sha:0:7} ('gh api rate_limit' fails too)"
retried bad-token 1

# --- One more try on exit 4 (P-842) --------------------------------------------
# A moment's trouble reading the run: the same run, read once more, is green.
# One failed read: its text names a network failure, so the gate needn't ask
# rate_limit (P-881).
scenario flake-clears "[$(run 11 "$sha" 2026-01-01T00:00:00Z)]" 11 completed success "$sha" ""
echo 1 >"$work/flake-clears/unreachable-reads"
expect flake-clears 0 "CI is green for ${sha:0:7} (run 11)"
retried flake-clears 1
grep -qE "couldn't reach GitHub while reading run 11 at [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z; trying once more" \
  "$work/flake-clears.out" ||
  { failed=$((failed + 1)); echo "FAIL  flake-clears doesn't record the run and the time"; }

# The trouble outlasts the one more try: exit 4, after exactly one.
scenario flake-persists "[$(run 11 "$sha" 2026-01-01T00:00:00Z)]" 11 completed success "$sha" ""
echo 4 >"$work/flake-persists/unreachable-reads"
expect flake-persists 4 "couldn't reach or authenticate with GitHub, and once more after 1s, while reading run 11"
retried flake-persists 1

# GitHub is reachable and says no: never the manual path, and never retried.
scenario github-answers-with-an-error "[]"
echo "HTTP 404: Not Found (https://api.github.com/repos/o/r/actions/runs)" >"$work/github-answers-with-an-error/list-error"
expect github-answers-with-an-error 5 "GitHub answered with an error while listing runs"
grep -qF "HTTP 404: Not Found" "$work/github-answers-with-an-error.out" ||
  { failed=$((failed + 1)); echo "FAIL  github-answers-with-an-error doesn't show GitHub's error"; }
retried github-answers-with-an-error 0

# --- A network failure is "couldn't reach" (P-881) -----------------------------
# gh's error text says the request never got an answer, though rate_limit
# answers a moment later: exit 4's one more try, never exit 5. Seen 18 October
# 2026: "TLS handshake timeout" from gh run view, which the gate called 5.
# view_fails NAME READS TEXT: run 11, green, whose first READS reads fail with TEXT.
view_fails() {
  scenario "$1" "[$(run 11 "$sha" 2026-01-01T00:00:00Z)]" 11 completed success "$sha" ""
  echo "$2" >"$work/$1/view-error-reads"
  printf '%s\n' "$3" >"$work/$1/view-error"
}
api="https://api.github.com/repos/o/r/actions/runs/11?exclude_pull_requests=true"
n=0
while IFS= read -r text; do
  n=$((n + 1))
  view_fails "network-error-clears-$n" 1 "$text"
  expect "network-error-clears-$n" 0 "CI is green for ${sha:0:7} (run 11)"
  retried "network-error-clears-$n" 1
done <<TEXTS
failed to get run: Get "$api": net/http: TLS handshake timeout
failed to get run: Get "$api": read tcp 10.0.0.2:52011->140.82.112.6:443: read: connection reset by peer
failed to get run: Get "$api": dial tcp 140.82.112.6:443: connect: connection refused
failed to get run: Get "$api": dial tcp: lookup api.github.com: no such host
failed to get run: Get "$api": dial tcp 140.82.112.6:443: i/o timeout
failed to get run: Get "$api": net/http: request canceled while waiting for connection (Client.Timeout exceeded while awaiting headers)
failed to get run: Get "$api": unexpected EOF
error connecting to api.github.com
TEXTS

view_fails network-error-persists 99 "failed to get run: Get \"$api\": net/http: TLS handshake timeout"
expect network-error-persists 4 "couldn't reach or authenticate with GitHub, and once more after 1s, while reading run 11 (a network error: failed to get run"
retried network-error-persists 1

# GitHub answered, so exit 5, even a 5xx, and even when its text says timeout.
view_fails github-answers-502 99 "HTTP 502: Bad Gateway ($api)"
expect github-answers-502 5 "GitHub answered with an error while reading run 11"
retried github-answers-502 0

view_fails http-status-wins 99 "HTTP 404: Not Found ($api): request timeout"
expect http-status-wins 5 "GitHub answered with an error while reading run 11"
retried http-status-wins 0

# Text the gate doesn't know, and rate_limit answers: exit 5, failing closed.
view_fails unknown-error-text 99 "failed to get run: something new"
expect unknown-error-text 5 "GitHub answered with an error while reading run 11"
retried unknown-error-text 0

echo "ci-gate-test: $passed passed, $failed failed"
((failed == 0))
