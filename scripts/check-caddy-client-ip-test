#!/usr/bin/env bash
# Tests scripts/check-caddy-client-ip (P-49, D-1021): it passes our Caddyfile, and
# fails, naming the forged address the API saw, on the Caddyfiles that would let
# a client choose its rate-limit bucket: no header_up at all (the forged header
# goes straight through), and header_up appending (`+`) instead of setting.
# Every case checks the exit code and the message. Needs Docker; runs locally
# and in CI.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
check="$here/check-caddy-client-ip"
ours="$here/../infra/gce/Caddyfile"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
failures=0

fail() {
  echo "check-caddy-client-ip-test: FAIL $*"
  failures=$((failures + 1))
}

# expect NAME CADDYFILE CODE MUST_CONTAIN
expect() {
  local name="$1" file="$2" want="$3" contains="$4" out code
  set +e
  out="$("$check" "$file" 2>&1)"
  code=$?
  set -e
  if [[ "$code" != "$want" ]]; then
    fail "$name: exit $code, want $want"
    printf '%s\n' "$out" | sed 's/^/    /'
  elif [[ "$out" != *"$contains"* ]]; then
    fail "$name: output lacks '$contains'"
    printf '%s\n' "$out" | sed 's/^/    /'
  else
    echo "check-caddy-client-ip-test: ok   $name"
  fi
}

expect "our Caddyfile passes" "$ours" 0 "every check passed."

grep -v 'header_up Caddy-Client-IP' "$ours" > "$work/no-header-up"
grep -v '^[[:space:]]*#' "$work/no-header-up" | grep -q 'header_up' && fail "the no-header-up copy still sets a header"
expect "without header_up, the forged address reaches the API" "$work/no-header-up" 1 \
  "FAIL forged Caddy-Client-IP: the API saw '203.0.113.66'"

sed 's/header_up Caddy-Client-IP/header_up +Caddy-Client-IP/' "$ours" > "$work/appending"
grep -q 'header_up +Caddy-Client-IP' "$work/appending" || fail "the appending copy wasn't made"
expect "header_up appending keeps the forged address beside the real one" "$work/appending" 1 \
  "FAIL forged Caddy-Client-IP: the API saw '203.0.113.66"

if ((failures > 0)); then
  echo "check-caddy-client-ip-test: $failures case(s) failed."
  exit 1
fi
echo "check-caddy-client-ip-test: every case passed."
