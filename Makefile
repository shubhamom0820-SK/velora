# Velora — developer entry points.
# Targets tagged [T-x.y] are stubs until that task lands. See docs/05-PLAN.md.

.DEFAULT_GOAL := help
.PHONY: help infra-up infra-down infra-reset dev worker seed test test-api test-web lint lint-api lint-web hooks migrate migrate-down migration migration-auto types e2e

COMPOSE := docker compose -f infra/docker-compose.yml

help: ## List the available targets
	@echo "Velora — make targets:"
	@grep -E '^[a-z][a-zA-Z0-9_-]*:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-15s %s\n", $$1, $$2}'

infra-up: ## Start docker: postgres+postgis, redis, s3 (SeaweedFS); stamp the dev database as local
	$(COMPOSE) up -d --wait db redis s3
	$(COMPOSE) run --rm s3-init
	@# The dev seed writes only to a database carrying this stamp (T-1.15, D-064).
	@# psql runs inside the container, so this reaches no other database.
	$(COMPOSE) exec -T db sh -c 'psql -v ON_ERROR_STOP=1 -q -U "$$POSTGRES_USER" -d "$$POSTGRES_DB"' < infra/postgres/stamp-local.sql

infra-down: ## Stop the docker stack, keeping data
	$(COMPOSE) down

infra-reset: ## Stop the docker stack and DROP all data volumes
	$(COMPOSE) down -v

dev: ## Run infra + api + web, all on 127.0.0.1 (worker joins with T-4.4)
	$(MAKE) infra-up
	@echo "api http://127.0.0.1:8000  web http://127.0.0.1:3000  (Ctrl-C stops both)"
	@trap 'kill 0' INT TERM; \
	( cd api && uv run uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload ) & \
	( cd web && pnpm dev --port 3000 ) & \
	wait

worker: ## Run the ARQ worker only [T-4.4]
	@echo "not yet — T-4.4"

seed: ## Dev data, local only: 20 profiles, 3 test accounts (re-run changes nothing)
	cd api && uv run python -m seed

test: test-api test-web ## api pytest + web vitest (CI runs each half as its own job)

test-api: ## api pytest: the critical tests first, then the rest (06-TESTING)
	cd api && uv run pytest -m critical && uv run pytest -m "not critical"

test-web: ## web vitest
	cd web && pnpm test

lint: lint-api lint-web ## api + web lint (CI runs each half as its own job)

lint-api: ## api: ruff + format check + strict mypy
	cd api && uv run ruff check . && uv run ruff format --check . && uv run mypy

lint-web: ## web: eslint + tsc + prettier check
	cd web && pnpm lint && pnpm typecheck && pnpm format:check

hooks: ## Install the git pre-commit hooks (once per clone)
	cd api && uv run pre-commit install

migrate: ## alembic upgrade head
	cd api && uv run alembic upgrade head

migrate-down: ## alembic downgrade one step
	cd api && uv run alembic downgrade -1

migration: ## New blank revision to write by hand: make migration m="message"
	@test -n "$(m)" || { echo 'usage: make migration m="what it does"'; exit 2; }
	cd api && uv run alembic revision -m "$(m)"

migration-auto: ## Autogenerated revision from the models (review the diff!): m="message"
	@test -n "$(m)" || { echo 'usage: make migration-auto m="what it does"'; exit 2; }
	cd api && uv run alembic revision --autogenerate -m "$(m)"

# contract_openapi(): each sign-in path is served only for its providers (D-066, D-085), and
# the types describe the whole contract, both paths, whatever provider your .env runs locally.
# AUTH_PHONE_PROVIDER=fake fixes the paths' order, so the file is the same everywhere.
types: ## Regenerate web/src/types/api.ts from the API's OpenAPI schema (offline: no server needed)
	@dir=$$(mktemp -d); \
	( cd api && AUTH_PHONE_PROVIDER=fake uv run python -c 'import json; from app.main import contract_openapi; print(json.dumps(contract_openapi()))' > $$dir/openapi.json ) \
		&& ( cd web && pnpm exec openapi-typescript $$dir/openapi.json -o src/types/api.ts ); \
	status=$$?; rm -rf $$dir; exit $$status

e2e: ## Playwright: a production build against the API on a P-55 slot of its own (needs make infra-up) [T-3.13]
	cd web && pnpm exec playwright test
