# Every variable the web app reads (02-ARCHITECTURE §11). Copy to .env.local to
# override one locally; `make dev` needs none of them. Staging and production set
# them in Vercel (T-1.22).
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time, so none
# of them may ever be secret (CLAUDE.md rule 13).

# --- API (T-1.18). Under `next dev` it defaults to this; other builds must set it. ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Real-time WebSocket (T-7.12) ---
NEXT_PUBLIC_WS_URL=

# --- Phone sign-in provider (D-035): firebase | msg91 | fake ---
AUTH_PHONE_PROVIDER=fake
# NEXT_PUBLIC_FIREBASE_* (apiKey, authDomain, projectId, appId, App Check site key)
# are named when T-3.14 adds Firebase sign-in.

# --- Web push (T-9.4) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Payments checkout (T-8.7) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Error reporting (T-9.12) ---
NEXT_PUBLIC_SENTRY_DSN=
