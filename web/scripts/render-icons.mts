/**
 * The installed app's icons (T-9.7, 08-DESIGN §7), rendered by hand, never in
 * `make test`:
 *
 *     node scripts/render-icons.mts          # from web/
 *
 * The same V as `src/app/apple-icon.png`: `--chrome-ink` on `--chrome`, bold,
 * in the system font stack, from a page that reads `tokens.css` itself, so no
 * colour is written here. Headless Chromium (Playwright's own), as T-2.4's
 * icons were, so it draws as macOS does: render on a Mac, or the V's shape
 * changes with the fallback font.
 *
 * - `icon-192.png` and `icon-512.png`: the apple icon's proportions, the V's
 *   cap height about half the tile.
 * - `icon-maskable-512.png`: smaller, so the whole V sits inside the centre
 *   80% circle a launcher may crop to (`manifest.test.ts` checks every pixel).
 *
 * Run it again when the name changes (the V; CLAUDE.md rule 17) or the theme
 * does (D-014), then commit what it wrote. The apple icon and the favicon
 * are T-2.4's, still regenerated by hand (08-DESIGN §7).
 */

import { readFileSync } from "node:fs";
import { join } from "node:path";

import { chromium } from "@playwright/test";

type Icon = {
  file: string;
  size: number;
  /** The V's font size, as a share of the tile. */
  glyph: number;
};

/** The apple icon's V is about 0.71 of its tile (180 px, a 128 px V). */
export const ICONS: Icon[] = [
  { file: "icon-192.png", size: 192, glyph: 0.71 },
  { file: "icon-512.png", size: 512, glyph: 0.71 },
  { file: "icon-maskable-512.png", size: 512, glyph: 0.56 },
];

const OUT = join("public", "icons");

function page(tokens: string, icon: Icon): string {
  return `<!doctype html><html><head><style>${tokens}
html,body{margin:0}
body{width:${icon.size}px;height:${icon.size}px;display:flex;align-items:center;justify-content:center;background:var(--chrome);color:var(--chrome-ink);font-family:var(--font-system);font-weight:700;font-size:${Math.round(icon.size * icon.glyph)}px;line-height:1}
</style></head><body><span>V</span></body></html>`;
}

async function main(): Promise<void> {
  const tokens = readFileSync(join("src", "styles", "tokens.css"), "utf8");
  const browser = await chromium.launch();
  try {
    for (const icon of ICONS) {
      const tab = await browser.newPage({
        viewport: { width: icon.size, height: icon.size },
        deviceScaleFactor: 1,
      });
      await tab.setContent(page(tokens, icon));
      await tab.screenshot({
        path: join(OUT, icon.file),
        clip: { x: 0, y: 0, width: icon.size, height: icon.size },
      });
      await tab.close();
      process.stdout.write(`${join(OUT, icon.file)}\n`);
    }
  } finally {
    await browser.close();
  }
}

if (import.meta.main) {
  await main();
}
