# The Secret Manager names the worker's container gets (P-49): the API's, the
# same values, plus Sightengine's. A trailing ? means optional. Names only.
DATABASE_URL
REDIS_URL
JWT_SECRET
PHONE_PEPPER
PHONE_ENC_KEY
CODE_PEPPER
R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY
RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET
SIGHTENGINE_API_USER
SIGHTENGINE_API_SECRET
# T-9.12 (D-1001): required, so a deploy stops here without it, as the app would.
SENTRY_DSN
VAPID_PRIVATE_KEY?
VAPID_PUBLIC_KEY?
