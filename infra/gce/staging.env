# Staging's settings that aren't secret (P-49), read by the API and the worker on
# the VM through compose.yml; the worker's pool and poll are set there. Secrets
# are in Secret Manager, never here (infra/STAGING.md). Raw: no quotes, no $.
ENV=staging
# D-045: outside local, every provider is a real one.
AUTH_PHONE_PROVIDER=firebase
# The project whose ID tokens sign in (D-085): velora-ic, shared with production
# (D-065) until P-66. Not a secret.
FIREBASE_PROJECT_ID=velora-ic
SMS_PROVIDER=msg91
PAYMENTS_PROVIDER=razorpay
MODERATION_PROVIDER=sightengine
FACEMATCH_PROVIDER=sface
STORAGE_PROVIDER=s3
# Off until the founder gives D-857 in their own words; turning it on needs the
# VAPID pair in Secret Manager first (infra/STAGING.md, P-755).
PUSH_PROVIDER=off
VAPID_SUBJECT=https://veloraapp.co.in/contact
# The staging web, the same site as api.staging. (P-33). Never velora-staging.vercel.app.
CORS_ORIGINS=https://staging.veloraapp.co.in
# The CSRF cookie's Domain (D-055): staging's host, never veloraapp.co.in.
COOKIE_DOMAIN=staging.veloraapp.co.in
# Per-IP limits read the address Caddy saw, set by Caddy alone (D-056, D-1021).
CLIENT_IP_HEADER=Caddy-Client-IP
# Per uvicorn process, two of them: at most 2 x (5 + 2) = 14 connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
# R2 (T-4.1): the account and the CDN aren't secrets; the token is.
R2_ACCOUNT_ID=82f9b26266ddb6b491a623971f87d3c7
R2_BUCKET_PUBLIC=velora-staging-public
R2_BUCKET_PRIVATE=velora-staging-private
PUBLIC_CDN_URL=https://cdn.staging.veloraapp.co.in
