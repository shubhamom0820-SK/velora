# The hosts Caddy serves and gets certificates for, comma-separated (P-49).
# api-mumbai.staging. is where the VM was proved; api.staging. joins it at the
# cutover (out/p-49-cutover.md, infra/STAGING.md). Until api.staging.'s DNS points
# here, Caddy's certificate requests for it fail and it retries on a backoff.
API_HOSTS=api-mumbai.staging.veloraapp.co.in, api.staging.veloraapp.co.in
