# The Secret Manager names the API's container gets (P-49), one per line, read by
# infra/gce/deploy. A trailing ? means optional: an empty slot is left out.
# Names only, never values.
DATABASE_URL
REDIS_URL
JWT_SECRET
PHONE_PEPPER
PHONE_ENC_KEY
CODE_PEPPER
R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY
RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET
SENTRY_DSN?
VAPID_PRIVATE_KEY?
VAPID_PUBLIC_KEY?
