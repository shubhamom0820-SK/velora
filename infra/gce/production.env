# Production's settings that aren't secret (P-49), read by the API and the worker
# on the VM through compose.yml; the worker's pool and poll are set there.
# Secrets are in Secret Manager, never here (infra/PRODUCTION.md). Raw: no quotes, no $.
ENV=production
AUTH_PHONE_PROVIDER=firebase
FIREBASE_PROJECT_ID=velora-ic
SMS_PROVIDER=msg91
PAYMENTS_PROVIDER=razorpay
MODERATION_PROVIDER=sightengine
FACEMATCH_PROVIDER=sface
STORAGE_PROVIDER=s3
# Off until D-857; the VAPID pair goes into Secret Manager first (P-755).
PUSH_PROVIDER=off
VAPID_SUBJECT=https://veloraapp.co.in/contact
CORS_ORIGINS=https://veloraapp.co.in
COOKIE_DOMAIN=veloraapp.co.in
CLIENT_IP_HEADER=Caddy-Client-IP
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
R2_ACCOUNT_ID=82f9b26266ddb6b491a623971f87d3c7
R2_BUCKET_PUBLIC=velora-prod-public
R2_BUCKET_PRIVATE=velora-prod-private
PUBLIC_CDN_URL=https://cdn.veloraapp.co.in
