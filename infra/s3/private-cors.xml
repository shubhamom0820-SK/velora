<!--
  The private bucket's CORS rule, for the local web (T-4.6) and the E2E's
  (T-4.9). The browser PUTs a photo straight to the bucket from another origin,
  with a Content-Type header, so it asks first, and SeaweedFS would otherwise
  answer any origin. This is staging's rule in Cloudflare, with the local
  origins: PUT and Content-Type only, nothing else, one rule per origin.
  s3-init sets it, and api/tests/test_local_s3_cors.py holds the bucket to it.
  - http://127.0.0.1:3000 is `make dev`'s web.
  - http://127.0.0.1:3100 is the E2E's production build (web/playwright.config.ts),
    whose journeys upload photos and a selfie.
-->
<CORSConfiguration>
  <CORSRule>
    <AllowedOrigin>http://127.0.0.1:3000</AllowedOrigin>
    <AllowedMethod>PUT</AllowedMethod>
    <AllowedHeader>Content-Type</AllowedHeader>
    <MaxAgeSeconds>3600</MaxAgeSeconds>
  </CORSRule>
  <CORSRule>
    <AllowedOrigin>http://127.0.0.1:3100</AllowedOrigin>
    <AllowedMethod>PUT</AllowedMethod>
    <AllowedHeader>Content-Type</AllowedHeader>
    <MaxAgeSeconds>3600</MaxAgeSeconds>
  </CORSRule>
</CORSConfiguration>
