# What never goes into the API image (T-1.22).
#
# P-32: a .env in an image is a secrets leak. It would bake the JWT secret, the
# database password and every provider key into an image pushed to Fly's
# registry, and Docker keeps deleted files in earlier layers, so once pushed
# every one of them must be rotated. CI builds with a planted .env and fails if
# any layer contains it (scripts/check-image-no-env).
.env
.env.*

# Local tooling and caches.
.venv
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache

# Not needed to run the API.
tests

# The face models (T-4.5): the build fetches and checks its own (D-088), so a
# local copy, whatever it holds, never enters the image.
models

# The dev seed (T-1.15, D-064): fake users, and phone numbers that may be real
# people's. Code that isn't in the image can't run in production, whatever a
# bug does to ENV. CI checks the built image has no /app/seed.
seed

# Benchmarks run by hand (T-4.11): mounted into a container when they run,
# never built into the image. The liveness probe's tools, torch and
# onnxruntime, never reach production (D-381). CI checks the built image has
# no /app/bench, and neither of them.
bench

# Checks run by hand from a laptop against outside services (T-9.12):
# scripts/sentry-alerts. Nothing in the running app needs them.
ops
