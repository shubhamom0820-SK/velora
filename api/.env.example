# Copy to .env and fill in. Real values are never committed (CLAUDE.md rule 13).
#
# The local-infrastructure values below are the ones `make infra-up` creates, so
# a fresh clone runs with no secrets. Everything genuinely secret is left empty.
#
# Every *_PROVIDER below may be `fake` only while ENV=local: anywhere else the
# API refuses to start until each names a real provider (D-045).

# --- Core (required — the app refuses to start without these) ---
ENV=local
DATABASE_URL=postgresql+asyncpg://velora:velora@127.0.0.1:5432/velora
REDIS_URL=redis://127.0.0.1:6379/0
# Keys, checked at startup (D-060): the API won't start on anything else.
# JWT_SECRET: openssl rand -hex 64 (128 hex characters or more).
# PHONE_PEPPER, PHONE_ENC_KEY, CODE_PEPPER: openssl rand -hex 32 each, all different.
# PHONE_PEPPER never changes once a number is banned (D-061). PHONE_ENC_KEY takes several
# keys, comma-separated and newest first, when one is rotated (D-061).
JWT_SECRET=
PHONE_PEPPER=
PHONE_ENC_KEY=
CODE_PEPPER=

# --- Database pool, per process: every uvicorn worker opens its own (infra/STAGING.md) ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Web origins and cookies ---
CORS_ORIGINS=http://127.0.0.1:3000
COOKIE_DOMAIN=
# The proxy's client-IP header, for per-IP rate limits: Fly-Client-IP on Fly.
# Empty locally, where the socket's address is the client's (D-056).
CLIENT_IP_HEADER=

# --- Auth provider (D-035): firebase | msg91 | fake ---
AUTH_PHONE_PROVIDER=fake
# Required where AUTH_PHONE_PROVIDER is firebase: the project whose ID tokens sign
# in (D-085). Not a secret; no service account goes with it. Locally you sign in
# by Path B on fake, so leave it empty.
FIREBASE_PROJECT_ID=

# --- SMS: msg91 | fake ---
SMS_PROVIDER=fake
# Locally, a real SMS provider (msg91) texts only these numbers, comma-separated:
# the seed's numbers may be real people's (D-064). Anything else gets 503
# PROVIDER_UNAVAILABLE. The fake sends nothing, so it needs none. Refused outside
# local (D-066).
SMS_LOCAL_ALLOWED_TO=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# --- Payments: razorpay | fake ---
PAYMENTS_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Moderation (worker): sightengine | fake ---
MODERATION_PROVIDER=fake
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# --- Face match (worker): rekognition | fake ---
FACEMATCH_PROVIDER=fake
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# --- Object storage (D-027, T-4.1). Locally the S3 is SeaweedFS from infra/docker-compose.yml (D-086). ---
# s3 | fake. s3 against it, so `make dev` and `make seed` store real files; tests
# use the fake regardless. R2_ENDPOINT_URL is refused anywhere but ENV=local: there,
# storage is R2's own endpoint, from R2_ACCOUNT_ID.
STORAGE_PROVIDER=s3
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=velora-local
R2_SECRET_ACCESS_KEY=velora-local-secret
R2_BUCKET_PUBLIC=velora-public
R2_BUCKET_PRIVATE=velora-private
R2_ENDPOINT_URL=http://127.0.0.1:9000
PUBLIC_CDN_URL=http://127.0.0.1:9000/velora-public

# --- Web push: webpush | fake (webpush is built in T-9.4) ---
PUSH_PROVIDER=fake
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Observability (SDK wired in T-9.12) ---
SENTRY_DSN=
